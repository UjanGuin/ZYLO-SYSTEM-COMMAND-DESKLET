#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/zylo-system-command-desklet"
if [[ ! -x "$RUNTIME_DIR/venv/bin/python" || ! -f "$RUNTIME_DIR/setup_app.py" ]]; then
  "$SCRIPT_DIR/install-extension.sh"
fi
exec "$RUNTIME_DIR/venv/bin/python" "$RUNTIME_DIR/setup_app.py" "$@"
